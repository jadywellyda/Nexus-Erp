<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.nexuserp.presentation.controller.CadastroProdutoController">
    <top>
        <Label text="Cadastro de Produto" styleClass="tituloPagina"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER">
            <VBox spacing="15">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <children>
                    <GridPane hgap="10" vgap="10">
                        <children>
                            <Label text="SKU"/>
                            <TextField fx:id="txtSku" GridPane.columnIndex="1"/>

                            <Label text="Nome" GridPane.rowIndex="1"/>
                            <TextField fx:id="txtNome" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Descrição" GridPane.rowIndex="2"/>
                            <TextField fx:id="txtDescricao" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Categoria" GridPane.rowIndex="3"/>
                            <ComboBox fx:id="cmbCategoria" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Preço Custo" GridPane.rowIndex="4"/>
                            <TextField fx:id="txtPrecoCusto" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Preço Venda" GridPane.rowIndex="5"/>
                            <TextField fx:id="txtPrecoVenda" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Estoque Mínimo" GridPane.rowIndex="6"/>
                            <TextField fx:id="txtEstoqueMinimo" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <Label text="Estoque Atual" GridPane.rowIndex="7"/>
                            <TextField fx:id="txtEstoqueAtual" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                        </children>
                    </GridPane>

                    <HBox spacing="10">
                        <children>
                            <Button fx:id="btnSalvar" text="Salvar" onAction="#handleSalvar"/>
                            <Button fx:id="btnVoltar" text="Voltar" onAction="#handleVoltar"/>
                        </children>
                    </HBox>

                    <TableView fx:id="tabelaProdutos">
                        <columns>
                            <TableColumn fx:id="colId" text="ID"/>
                            <TableColumn fx:id="colSku" text="SKU"/>
                            <TableColumn fx:id="colNome" text="Nome"/>
                            <TableColumn fx:id="colPrecoVenda" text="Preço Venda"/>
                            <TableColumn fx:id="colEstoque" text="Estoque"/>
                        </columns>
                    </TableView>
                </children>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
